# Copy to .env.local and fill in. Never commit real keys.

# Public site URL (used in Stripe redirects and download links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers → API keys / Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Lulu Print API (developers.lulu.com). Use the sandbox until a test order succeeds.
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Email Lulu uses for print questions (yours, never shown to readers)
LULU_CONTACT_EMAIL=
# Shared secret appended to the Lulu webhook URL (?secret=...)
LULU_WEBHOOK_SECRET=

# What the reader pays for shipping a printed order, in cents (Lulu charges us ~790 to Greece)
SHIPPING_FEE_CENTS=490
# Platform commission on author sales, in percent
PLATFORM_COMMISSION_PERCENT=20
